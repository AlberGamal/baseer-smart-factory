# Copy this file to .env and replace every CHANGE_ME value before starting.
# Do not commit .env.

# ── Database ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password
POSTGRES_DB=baseer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── API ────────────────────────────────────────────────────
APP_ENV=development
BASEER_SECRET=CHANGE_ME_at_least_32_random_characters
BASEER_INGEST_KEY=CHANGE_ME_random_worker_ingestion_key
CORS_ORIGINS=http://localhost:8080
ALLOW_SELF_REGISTRATION=false

# ── One-shot bootstrap ────────────────────────────────────
BOOTSTRAP_MANAGER_USERNAME=manager
BOOTSTRAP_MANAGER_PASSWORD=CHANGE_ME_strong_manager_password
BOOTSTRAP_EMPLOYEE_PASSWORD=CHANGE_ME_strong_employee_password

# ── Dashboard (browser → API) ──────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Telegram notifier (optional integration) ──────────────
TELEGRAM_BOT_TOKEN=
